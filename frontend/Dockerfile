FROM node:20-alpine AS build
WORKDIR /app
ARG VITE_API_BASE_URL=http://localhost:4000/api
ARG VITE_STUN_SERVERS=
ARG VITE_TURN_SERVER=
ARG VITE_TURN_USER=
ARG VITE_TURN_PASS=
ARG VITE_RELAY_ENABLED=true
ARG VITE_LOCAL_DISCOVERY_ENABLED=true
ARG VITE_LOCAL_DISCOVERY_URL=ws://localhost:4010
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_STUN_SERVERS=${VITE_STUN_SERVERS}
ENV VITE_TURN_SERVER=${VITE_TURN_SERVER}
ENV VITE_TURN_USER=${VITE_TURN_USER}
ENV VITE_TURN_PASS=${VITE_TURN_PASS}
ENV VITE_RELAY_ENABLED=${VITE_RELAY_ENABLED}
ENV VITE_LOCAL_DISCOVERY_ENABLED=${VITE_LOCAL_DISCOVERY_ENABLED}
ENV VITE_LOCAL_DISCOVERY_URL=${VITE_LOCAL_DISCOVERY_URL}
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.27-alpine AS runner
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 5173
CMD ["nginx", "-g", "daemon off;"]
